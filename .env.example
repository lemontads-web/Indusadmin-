# Copy this file to .env.local and fill in the two values from
# Supabase → Project Settings → API.  (.env.local is git-ignored.)
#
# Project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=
# "anon" / "publishable" key — safe to use in the website.
# NEVER put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=
